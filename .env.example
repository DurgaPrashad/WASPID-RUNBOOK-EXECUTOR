# Copy to .env (gitignored) and fill in what you use. scripts/live.sh generates the
# first two for you. Never commit real keys.

# --- Core ----------------------------------------------------------------
WASPID_DB_PASSWORD=                 # demo Postgres password
WASPID_OPERATOR_TOKEN=              # operator console sign-in token
# WASPID_FAKE_DOCKER=1              # run without Docker (in-memory engine)
# WASPID_RUNBOOK=aws_ecs_redeploy.yaml

# --- WASPID platform (API + DB) --------------------------------------------
# WASPID_API_URL=http://127.0.0.1:8080
# WASPID_DB_CONTAINER=waspid-db
# WASPID_DB_USER=waspid
# WASPID_DB_NAME=waspid

# --- LLM: OpenAI ------------------------------------------------------------
# OPENAI_API_KEY=
# WASPID_MODEL=gpt-5-mini

# --- LLM: TrueFoundry AI Gateway (OpenAI-compatible) -------------------------
# TFY_API_KEY=
# TFY_GATEWAY_BASE_URL=             # from the AI Gateway "code snippet" in the TrueFoundry UI
# WASPID_MODEL=                     # gateway model id, e.g. openai-main/gpt-5-mini
# WASPID_LLM_PROVIDER=truefoundry   # force a provider when both are configured

# --- AWS (opt-in) ------------------------------------------------------------
# WASPID_ENABLE_AWS=1               # credentials: standard AWS chain (profile / SSO / IAM role)
# AWS_REGION=us-east-1
# AWS_PROFILE=waspid-operator
# WASPID_FAKE_AWS=1                 # simulated AWS for demos and CI
